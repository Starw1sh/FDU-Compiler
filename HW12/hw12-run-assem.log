cd /home/guxue/fducompilerh2026/HW12/test/k2 && \
for file in $(ls .); do \
	if [ "${file#*.}" = "colored.s" ]; then \
	    echo "Running ${file} ........." ; \
		arm-linux-gnueabihf-gcc -mcpu=cortex-a72 -Wall -Wextra  -Wextra -Wl,-z,noexecstack --static -o "${file%%.*}" "${file%%.*}.colored.s" /home/guxue/fducompilerh2026/HW12/vendor/libsysy/libsysy32.s -lm; \
            echo "Running the final assembly program with k=2........." ; \
            qemu-arm "${file%%.*}"; \
		arm-linux-gnueabihf-gcc -mcpu=cortex-a72 -Wall -Wextra  -Wextra -Wl,-z,noexecstack  --static -o "../k5/${file%%.*}" "../k5/${file%%.*}.colored.s" /home/guxue/fducompilerh2026/HW12/vendor/libsysy/libsysy32.s -lm; \
            echo "Running the final assembly program with k=5........." ; \
            qemu-arm "../k5/${file%%.*}"; \
		arm-linux-gnueabihf-gcc -mcpu=cortex-a72 -Wall -Wextra  -Wextra -Wl,-z,noexecstack  --static -o "../k9/${file%%.*}" "../k9/${file%%.*}.colored.s" /home/guxue/fducompilerh2026/HW12/vendor/libsysy/libsysy32.s -lm; \
            echo "Running the final assembly program with k=9........." ; \
            qemu-arm "../k9/${file%%.*}"; \
        fi; \
    done; \
    cd .. > /dev/null 2>&1 
